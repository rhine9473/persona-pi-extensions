{
  "name": "rhine-pi-extensions",
  "version": "1.0.0",
  "description": "Pi Coding Agent 增强扩展套件：半透明圆角 TUI 美化、独立子代理与 Stravia 网关通道。",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs extensions/ui/*/*.test.mjs extensions/providers/*/*.test.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/ui/pi-ui-tool-fold",
      "./extensions/ui/pi-ui-user-card",
      "./extensions/ui/pi-ui-extension-manager",
      "./extensions/ui/pi-ui-smart-models",
      "./extensions/ui/pi-ui-sessions",
      "./extensions/ui/pi-ui-turn-time",
      "./extensions/ui/pi-ui-input-fold",
      "./extensions/ui/pi-ui-image-paste",
      "./extensions/tools/pi-tool-subagents",
      "./extensions/tools/pi-tool-bash-timeout",
      "./extensions/providers/pi-provider-stravia/index.ts"
    ],
    "skills": [
      "./extensions/tools/pi-tool-subagents/skills/subagents"
    ]
  },
  "dependencies": {
    "effect": "^4.0.0-beta.103"
  }
}
